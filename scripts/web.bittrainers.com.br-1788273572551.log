function extrairItensPaginaAtual() {
    // Busca os cards dentro da página ativa do Ionic
    const containerAtivo = document.querySelector('ion-router-outlet > .ion-page:not(.ion-page-hidden)') || document;
    const cards = containerAtivo.querySelectorAll('.btt-card-preview--content');

    const titulosUnicos = new Set();
    const itens = [];

    cards.forEach(card => {
        // Verifica se o elemento está visível e tem texto
        const visivel = card.offsetParent !== null;
        const texto = card.innerText.trim();

        if (visivel && texto.length > 0 && !titulosUnicos.has(texto)) {
            titulosUnicos.add(texto);
            itens.push({
                nome: texto,
                tipo: 'DICA' // Alterne para 'RECEITA' se necessário
            });
        }
    });

    console.log(`✅ ${itens.length} itens encontrados na página atual:`);
    console.table(itens);
    return itens;
}

